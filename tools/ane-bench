#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""MobileNetV1 baseline bench using existing libane and compiler graph runner."""
import argparse
import ctypes as C
import hashlib
import json
import math
from pathlib import Path
import sys
import tempfile
import subprocess
import time
import numpy as np

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT/'bindings/python/python'))
from ane import Fallback, OnnxCPU


def verify(root, metadata):
    for name, expected in [(metadata['cpu']['file'], metadata['cpu']['sha256']),
                           ('model.mil', metadata['provenance']['mil_sha256']),
                           ('weights.bin', metadata['provenance']['weights_sha256'])]:
        path = (root/name).resolve()
        if path.parent != root.resolve() or hashlib.sha256(path.read_bytes()).hexdigest() != expected:
            raise ValueError(f'model identity mismatch: {name}')


def native_benchmark(root, compiler, inputs, library, iterations, deadline):
    """Delegate all validation, packing, residency, dispatch and parity to the
    published runner. The child owns libane contexts, never this tool.
    """
    import subprocess
    lib = C.CDLL(str(library))
    lib.pyane_query_caps.argtypes = [C.c_int,C.POINTER(C.c_uint32),C.POINTER(C.c_uint32)]
    lib.pyane_query_caps.restype = C.c_int
    abi, chip = C.c_uint32(), C.c_uint32()
    rc = lib.pyane_query_caps(0,C.byref(abi),C.byref(chip))
    if rc or (abi.value,chip.value) != (1,13):
        raise OSError(f'H13 runner unavailable: caps rc={rc}, ABI={abi.value}, chip={chip.value}')
    temporary = Path(tempfile.mkdtemp(prefix="ane-bench-native-"))
    result = temporary/'result.json'
    command = [sys.executable,str(compiler/'tools/h13_run_linux.py'),
               str(root/'compiler-probes/H13/full-model'),'--mil',str(root/'model.mil'),
               '--model-root',str(root),'--libane-library',str(library),'--warmup','20',
               '--iterations',str(iterations),'--deadline-seconds',str(deadline),
               '--benchmark-json',str(result)]
    for name, value in inputs.items():
        path = temporary/(name+'.fp16'); path.write_bytes(value.tobytes())
        command += ['--input',f'{name}={path}']
    command += ['--output',f'probabilities={temporary/"probabilities.fp16"}']
    process = subprocess.Popen(command,stdout=subprocess.PIPE,stderr=subprocess.PIPE,
                               text=True,start_new_session=True)
    interrupted = None
    while True:
        try:
            stdout, stderr = process.communicate()
            break
        except (KeyboardInterrupt, SystemExit) as error:
            # The existing runner owns in-flight kernel work and cleanup.
            # A wrapper cancellation must not kill that owner mid-submission.
            interrupted = error
    (temporary/"stdout.log").write_text(stdout)
    (temporary/"stderr.log").write_text(stderr)
    (temporary/"command.json").write_text(json.dumps(command))
    if interrupted is not None:
        (temporary/"interrupted.txt").write_text("wrapper interrupted; waited for native runner cleanup\n")
        raise interrupted
    if process.returncode:
        raise OSError(f'compiler runner rc={process.returncode}; preserved {temporary}: {stderr[-2000:]}')
    report = json.loads(result.read_text())
    report['receipt_directory'] = str(temporary)
    return report['endToEnd']['samples'], report


def summary(samples, batch):
    a = sorted(samples)
    duration = sum(a)
    return {'calls':len(a),'inference_s':duration,'calls_per_s':len(a)/duration,
            'images_per_s':len(a)*batch/duration,'lat_ms_p50':a[len(a)//2]*1000,
            'lat_ms_p90':a[len(a)*9//10]*1000,'lat_ms_min':a[0]*1000}


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('model',type=Path)
    p.add_argument('seconds',type=float,nargs='?',default=8,help='CPU measurement duration; native uses --iterations')
    p.add_argument('--libane',type=Path,default=ROOT/'bindings/python/dylib/libane_python.so')
    # Native execution is deliberately a lead-run path, after controller approval.
    p.add_argument('--native-runner',type=Path,help='pinned mil-hwx-compiler checkout; H13 only')
    p.add_argument('--iterations',type=int,default=1000,help='native runner iterations')
    a = p.parse_args()
    if not math.isfinite(a.seconds) or not 0 < a.seconds <= 3600 or not 1 <= a.iterations <= 200000:
        p.error('seconds must be in (0,3600], iterations in [1,200000]')
    root = a.model.resolve()
    metadata = json.loads((root/'model.json').read_text()); verify(root, metadata)
    start = time.perf_counter()
    cpu = OnnxCPU(root/metadata['cpu']['file'])
    load_s = time.perf_counter()-start
    inputs = {i.name:((np.arange(np.prod(i.shape))%251)/251).astype(np.float16).reshape(i.shape) for i in cpu.inputs}
    expected = cpu(inputs)
    native_failure = None
    package = root/'compiler-probes/H13/full-model/manifest.json'
    if a.native_runner and package.is_file():
        try:
            # The upstream H13 inspector refuses other targets before loading.
            samples, detail = native_benchmark(root,a.native_runner.resolve(),inputs,a.libane.resolve(),a.iterations,a.seconds+120)
            print(json.dumps({'model':metadata['model'],'batch':metadata['batch'],'backend':'ane',
                              'warmup':20,'numerical_parity_checked':True,'native_report':detail,
                              **summary(samples,metadata['batch'])}))
            return
        except (OSError,ValueError,subprocess.TimeoutExpired) as error:
            native_failure = str(error)
    reason = 'native-failed' if native_failure else 'native-runner-not-requested'
    if not package.is_file():
        gaps = root/'compiler-gaps.json'
        reason = 'compiler-not-run' if not gaps.is_file() else 'native-package-unavailable'
        if gaps.is_file():
            records = json.loads(gaps.read_text()).get('targets',{}).get('H13',[])
            full = next((r for r in records if r.get('name') == 'full-model'),None)
            if full and full.get('rc'):
                code = full['rc']
                reason = 'compiler-refused' if code == 65 else 'compiler-timeout' if code == 124 else 'compiler-failed'
    if native_failure: reason = 'native-failed'
    fallback = Fallback(cpu,library=a.libane)
    max_error = 0.0
    def run():
        nonlocal max_error
        output, call = fallback.run(inputs)
        for name, expected_value in expected.items():
            actual = output[name]
            np.testing.assert_allclose(actual,expected_value,atol=1e-4,rtol=.02)
            max_error = max(max_error,float(np.max(np.abs(actual.astype(np.float32)-expected_value))))
        return call.latency_ns/1e9
    for _ in range(20): run()
    samples = []
    wall = time.perf_counter()
    while (not samples or time.perf_counter()-wall < a.seconds) and len(samples) < 200000:
        samples.append(run())
    result = {'model':metadata['model'],'batch':metadata['batch'],'backend':'cpu','reason':reason,
              'native_failure':native_failure,'load_s':load_s,'warmup':20,
              'wall_s':time.perf_counter()-wall,'numerical_parity_checked':True,'max_abs_error':max_error,
              'weights_sha256':metadata['provenance']['weights_sha256'],**summary(samples,metadata['batch'])}
    print(json.dumps(result))

if __name__ == '__main__': main()
