program(1.3)
[buildInfo = dict<string, string>({})]
{
  func main<ios18>(tensor<fp16, [1, 1, 64, 64]> x) {
    tensor<fp16, [8, 1, 3, 3]> enc_weight_0 = const()[name = string("enc_weight_0"), val = tensor<fp16, [8, 1, 3, 3]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(128)))];
    tensor<fp16, [8]> enc_bias_0 = const()[name = string("enc_bias_0"), val = tensor<fp16, [8]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(384)))];
    tensor<int32, [2]> enc_strides_0 = const()[name = string("enc_strides_0"), val = tensor<int32, [2]>([1, 1])];
    string enc_pad_type_0 = const()[name = string("enc_pad_type_0"), val = string("same")];
    tensor<int32, [4]> enc_pad_0 = const()[name = string("enc_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
    tensor<int32, [2]> enc_dilations_0 = const()[name = string("enc_dilations_0"), val = tensor<int32, [2]>([1, 1])];
    int32 enc_groups_0 = const()[name = string("enc_groups_0"), val = int32(1)];
    tensor<fp16, [1, 8, 64, 64]> enc = conv(x = x, weight = enc_weight_0, bias = enc_bias_0, strides = enc_strides_0, pad_type = enc_pad_type_0, pad = enc_pad_0, dilations = enc_dilations_0, groups = enc_groups_0)[name = string("enc")];
    tensor<fp16, [1, 8, 64, 64]> skip = relu(x = enc)[name = string("skip")];
    tensor<fp16, [8, 8, 3, 3]> down_weight_0 = const()[name = string("down_weight_0"), val = tensor<fp16, [8, 8, 3, 3]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(512)))];
    tensor<fp16, [8]> down_bias_0 = const()[name = string("down_bias_0"), val = tensor<fp16, [8]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(1728)))];
    tensor<int32, [2]> down_strides_0 = const()[name = string("down_strides_0"), val = tensor<int32, [2]>([2, 2])];
    string down_pad_type_0 = const()[name = string("down_pad_type_0"), val = string("same")];
    tensor<int32, [4]> down_pad_0 = const()[name = string("down_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
    tensor<int32, [2]> down_dilations_0 = const()[name = string("down_dilations_0"), val = tensor<int32, [2]>([1, 1])];
    int32 down_groups_0 = const()[name = string("down_groups_0"), val = int32(1)];
    tensor<fp16, [1, 8, 32, 32]> down = conv(x = skip, weight = down_weight_0, bias = down_bias_0, strides = down_strides_0, pad_type = down_pad_type_0, pad = down_pad_0, dilations = down_dilations_0, groups = down_groups_0)[name = string("down")];
    tensor<fp16, [1, 8, 32, 32]> down_relu = relu(x = down)[name = string("down_relu")];
    tensor<fp16, [8, 8, 3, 3]> mid_weight_0 = const()[name = string("mid_weight_0"), val = tensor<fp16, [8, 8, 3, 3]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(1856)))];
    tensor<fp16, [8]> mid_bias_0 = const()[name = string("mid_bias_0"), val = tensor<fp16, [8]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(3072)))];
    tensor<int32, [2]> mid_strides_0 = const()[name = string("mid_strides_0"), val = tensor<int32, [2]>([1, 1])];
    string mid_pad_type_0 = const()[name = string("mid_pad_type_0"), val = string("same")];
    tensor<int32, [4]> mid_pad_0 = const()[name = string("mid_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
    tensor<int32, [2]> mid_dilations_0 = const()[name = string("mid_dilations_0"), val = tensor<int32, [2]>([1, 1])];
    int32 mid_groups_0 = const()[name = string("mid_groups_0"), val = int32(1)];
    tensor<fp16, [1, 8, 32, 32]> mid = conv(x = down_relu, weight = mid_weight_0, bias = mid_bias_0, strides = mid_strides_0, pad_type = mid_pad_type_0, pad = mid_pad_0, dilations = mid_dilations_0, groups = mid_groups_0)[name = string("mid")];
    tensor<fp16, [1, 8, 32, 32]> low = relu(x = mid)[name = string("low")];
    fp32 up_scale_factor_height_0 = const()[name = string("up_scale_factor_height_0"), val = fp32(2.0)];
    fp32 up_scale_factor_width_0 = const()[name = string("up_scale_factor_width_0"), val = fp32(2.0)];
    tensor<fp16, [1, 8, 64, 64]> up = upsample_nearest_neighbor(x = low, scale_factor_height = up_scale_factor_height_0, scale_factor_width = up_scale_factor_width_0)[name = string("up")];
    tensor<fp16, [1, 8, 64, 64]> merged = add(x = up, y = skip)[name = string("merged")];
    tensor<fp16, [8, 8, 3, 3]> dec_weight_0 = const()[name = string("dec_weight_0"), val = tensor<fp16, [8, 8, 3, 3]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(3200)))];
    tensor<fp16, [8]> dec_bias_0 = const()[name = string("dec_bias_0"), val = tensor<fp16, [8]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(4416)))];
    tensor<int32, [2]> dec_strides_0 = const()[name = string("dec_strides_0"), val = tensor<int32, [2]>([1, 1])];
    string dec_pad_type_0 = const()[name = string("dec_pad_type_0"), val = string("same")];
    tensor<int32, [4]> dec_pad_0 = const()[name = string("dec_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
    tensor<int32, [2]> dec_dilations_0 = const()[name = string("dec_dilations_0"), val = tensor<int32, [2]>([1, 1])];
    int32 dec_groups_0 = const()[name = string("dec_groups_0"), val = int32(1)];
    tensor<fp16, [1, 8, 64, 64]> dec = conv(x = merged, weight = dec_weight_0, bias = dec_bias_0, strides = dec_strides_0, pad_type = dec_pad_type_0, pad = dec_pad_0, dilations = dec_dilations_0, groups = dec_groups_0)[name = string("dec")];
    tensor<fp16, [1, 8, 64, 64]> decoded = relu(x = dec)[name = string("decoded")];
    tensor<fp16, [1, 8, 3, 3]> head_weight_0 = const()[name = string("head_weight_0"), val = tensor<fp16, [1, 8, 3, 3]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(4544)))];
    tensor<fp16, [1]> head_bias_0 = const()[name = string("head_bias_0"), val = tensor<fp16, [1]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(4800)))];
    tensor<int32, [2]> head_strides_0 = const()[name = string("head_strides_0"), val = tensor<int32, [2]>([1, 1])];
    string head_pad_type_0 = const()[name = string("head_pad_type_0"), val = string("same")];
    tensor<int32, [4]> head_pad_0 = const()[name = string("head_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
    tensor<int32, [2]> head_dilations_0 = const()[name = string("head_dilations_0"), val = tensor<int32, [2]>([1, 1])];
    int32 head_groups_0 = const()[name = string("head_groups_0"), val = int32(1)];
    tensor<fp16, [1, 1, 64, 64]> head = conv(x = decoded, weight = head_weight_0, bias = head_bias_0, strides = head_strides_0, pad_type = head_pad_type_0, pad = head_pad_0, dilations = head_dilations_0, groups = head_groups_0)[name = string("head")];
    tensor<fp16, [1, 1, 64, 64]> restored = sub(x = x, y = head)[name = string("restored")];
    fp16 denoised_alpha_0 = const()[name = string("denoised_alpha_0"), val = fp16(0.0)];
    fp16 denoised_beta_0 = const()[name = string("denoised_beta_0"), val = fp16(1.0)];
    tensor<fp16, [1, 1, 64, 64]> denoised = clip(x = restored, alpha = denoised_alpha_0, beta = denoised_beta_0)[name = string("denoised")];
  } -> (denoised);
}
